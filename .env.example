# Copy this file to .env and fill in the values marked REQUIRED.

# REQUIRED - Neon: use the POOLED connection string here (host contains "-pooler").
DATABASE_URL=postgresql://user:password@your-host-pooler.neon.tech/neondb?sslmode=require

# Optional - Neon DIRECT (non-pooled) connection string. Used only by `npm run db:push`.
# If empty, DATABASE_URL is used for that as well.
DATABASE_URL_DIRECT=

# REQUIRED - long random string (32+ chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-please

NODE_ENV=development
PORT=3000

# Comma-separated list of allowed browser origins (the web app URL).
CORS_ORIGIN=http://localhost:5173

# 1 = real time. 60 = one real minute counts as one game hour (great for testing).
GAME_SPEED=1

# How often the server checks for finished buildings, recruits, AI turns (ms).
TICK_MS=5000

# Hours of absence before the AI takes over a player's country.
INACTIVITY_HOURS=48

# Seconds between AI decisions per AI country (divided by GAME_SPEED).
AI_INTERVAL_SECONDS=300
# How often an AI country at war decides (reinforce, counterattack). Divided by GAME_SPEED.
AI_WAR_INTERVAL_SECONDS=60

SCHEDULER_ENABLED=true
ALLOW_CAMPAIGN_CREATION=true
